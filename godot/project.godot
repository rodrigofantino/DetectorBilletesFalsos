; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Counterfeit Banknote Detector"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.5")
config/icon="res://assets/ui/app_icon_512.png"

[autoload]

AppState="*res://scripts/core/app_state.gd"
AppAds="*res://scripts/core/ad_service.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[rendering]

textures/vram_compression/import_etc2_astc=true
textures/default_texture_filter=0
